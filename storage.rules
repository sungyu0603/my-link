rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ──────────────────────────────────────────────
    // 프로필 아바타 이미지
    // 경로: avatars/{userId}/{fileName}
    //
    // ※ 현재 Storage 업로드 기능이 미구현 상태입니다.
    //   향후 프로필 사진 업로드를 추가할 때 아래 경로를 사용하세요.
    //
    // 클라이언트 예시:
    //   const storageRef = ref(storage, `avatars/${user.uid}/profile.jpg`);
    //   await uploadBytes(storageRef, file);
    //   const url = await getDownloadURL(storageRef);
    // ──────────────────────────────────────────────
    match /avatars/{userId}/{fileName} {

      // 읽기: 누구나 가능 (공개 프로필 아바타)
      allow read: if true;

      // 쓰기: 로그인 + 본인 ID 일치 + 파일 조건 검사
      allow write: if request.auth != null
        && request.auth.uid == userId
        // 파일 크기 5MB 이하
        && request.resource.size <= 5 * 1024 * 1024
        // 이미지 형식만 허용 (JPEG, PNG, WebP, GIF)
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');

      // 삭제: 본인만 가능
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ──────────────────────────────────────────────
    // 기본 차단: 위 경로 외 모든 접근 거부
    // ──────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
